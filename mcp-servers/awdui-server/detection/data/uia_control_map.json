{
  "schema_version": 1,
  "source_url": "https://learn.microsoft.com/en-us/dotnet/framework/ui-automation/control-pattern-mapping-for-ui-automation-clients",
  "source_note": "Conditional/must patterns per Microsoft UIA; MCP tools are AwdUI-specific.",
  "controls": {
    "AppBar": {
      "patterns_ms": { "must": ["ExpandCollapse", "Toggle"], "conditional": [], "not": ["Invoke"] },
      "read": ["spy_inspect", "list_elements"],
      "act": [
        { "id": "map_appbar_toggle", "tools": ["invoke_element"], "patterns": ["Toggle"], "steps": ["invoke_element toggles AppBar visibility"] },
        { "id": "map_appbar_expand", "tools": ["expand_element"], "patterns": ["ExpandCollapse"], "steps": ["expand_element on AppBar sections"] }
      ],
      "fallback": ["click_element"]
    },
    "Button": {
      "patterns_ms": { "must": [], "conditional": ["ExpandCollapse", "Invoke", "Toggle", "Value"], "not": [] },
      "read": ["spy_inspect", "get_element_properties"],
