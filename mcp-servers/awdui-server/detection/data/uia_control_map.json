        { "id": "map_invoke", "tools": ["invoke_element"], "patterns": ["Invoke"], "steps": ["invoke_element — InvokePattern (MS conditional)"] },
        { "id": "map_toggle", "tools": ["invoke_element"], "patterns": ["Toggle"], "steps": ["invoke_element — TogglePattern"] },
